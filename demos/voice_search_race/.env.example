# Search lanes. Keenable is optional (falls back to the keyless public endpoint, rate limited per IP);
# the other three lanes show an error until their key is set.
KEENABLE_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# Which lane the voice agent answers from, and which tier the race runs at.
ACTIVE_PROVIDER=keenable
RACE_TIER=fast            # fast = realtime / fast / ultra-fast / instant ; standard = pro / web / basic / auto

# Gradium voice (speech-to-text + text-to-speech). Only needed for the mic.
GRADIUM_API_KEY=

# Conversational LLM (OpenAI-compatible, must support tool calling). Also used for the one-sentence answer per lane.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
